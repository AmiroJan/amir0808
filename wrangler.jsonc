{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amir0808",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a6d749d9-9200-4a70-bd70-b17d7ce6ab09","database_name": "amir808" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "478bc3a28f87437b9c8d2ee63d9cad9c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
